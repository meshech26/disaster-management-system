# Disaster Management System - Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local MongoDB URI
# e.g.: mongodb+srv://<username>:<password>@cluster0.mongodb.net/disaster_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/disaster_management

# Authentication JWT
JWT_SECRET=disaster_emergency_response_system_secret_key_2026
JWT_EXPIRES_IN=7d

# Cloudinary (Sign up at cloudinary.com for free credentials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your_expo_access_token

# Frontend Web Origin
CLIENT_URL=http://localhost:8081
